{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>home-operations/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process Annotations in Docker Bake",
      "managerFilePatterns": [
        "/(^|/)docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Process commit-SHA annotations in Docker Bake",
      "managerFilePatterns": [
        "/(^|/)docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\" // renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))? currentValue=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "{{{datasource}}}"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Release Rules for Application Updates"
      ],
      "addLabels": [
        "app/{{parentDir}}"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "commitMessageTopic": "{{depName}}",
      "matchFileNames": [
        "**/docker-bake.hcl",
        "**/Dockerfile"
      ],
      "semanticCommitScope": "{{parentDir}}",
      "semanticCommitType": "release"
    },
    {
      "description": [
        "Auto-merge Application Updates"
      ],
      "matchFileNames": [
        "**/docker-bake.hcl"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": [
        "Exempt App Updates from prHourlyLimit and create them last, since they still add to the hourly PR count"
      ],
      "matchFileNames": [
        "apps/**"
      ],
      "prHourlyLimit": 0,
      "prPriority": -1
    },
    {
      "description": [
        "kserve: move the vLLM stack as one PR, never automerged"
      ],
      "matchFileNames": [
        "apps/kserve-huggingfaceserver/docker-bake.hcl",
        "apps/kserve-huggingfaceserver/Dockerfile"
      ],
      "matchDepNames": [
        "vllm",
        "transformers"
      ],
      "groupName": "kserve vLLM stack",
      "groupSlug": "kserve-vllm-stack",
      "automerge": false
    },
    {
      "description": [
        "Allowed Ubuntu Version for Base Images"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/ubuntu/"
      ],
      "allowedVersions": "/^(25\\.10|26\\.04)$/"
    },
    {
      "description": [
        "Allowed Alpine Version for Base Images"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/alpine/"
      ],
      "allowedVersions": "/3\\.22/"
    },
    {
      "description": [
        "Allowed Python Version for Debian Slim Base Images"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/python/"
      ],
      "allowedVersions": "/3\\.12\\.\\d+-slim-bookworm/"
    },
    {
      "description": [
        "Node: stay on the current even LTS major (block odd/non-LTS 25+)"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/node/"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": [
        "Bun builder: stay on 1.2.x (bun.lock / --frozen-lockfile compatibility)"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/oven/"
      ],
      "allowedVersions": "<1.3"
    },
    {
      "description": [
        "Auto-merge node/bun base image minor+patch on green CI"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/Dockerfile"
      ],
      "matchPackageNames": [
        "/node/",
        "/oven/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    },
    {
      "description": [
        "llm-inference-bench: python base capped at 3.14 - psutil publishes no cp315 wheels, so a 3.15 base fails the dependency install"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "apps/llm-inference-bench/Dockerfile"
      ],
      "matchPackageNames": [
        "/python/"
      ],
      "allowedVersions": "/3\\.14\\.\\d+-slim-bookworm/"
    },
    {
      "description": [
        "nixl-cu13: stay on the 1.2 line, the last one vLLM can import"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "apps/kserve-huggingfaceserver/Dockerfile"
      ],
      "matchPackageNames": [
        "nixl-cu13"
      ],
      "allowedVersions": "<1.3"
    },
    {
      "description": [
        "Auto-merge llm-inference-bench python/uv base image minor+patch on green CI"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "apps/llm-inference-bench/Dockerfile"
      ],
      "matchPackageNames": [
        "/python/",
        "ghcr.io/astral-sh/uv"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    },
    {
      "description": [
        "Commit pins watch exactly the branch named in the annotation - git-refs ranks every ref, so without this a fork jumps release lines"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "**/docker-bake.hcl"
      ],
      "matchDepNames": [
        "McCloudS/subgen",
        "kagent-dev/kagent",
        "rldiao/mealie-mcp-server",
        "ostris/ai-toolkit"
      ],
      "allowedVersions": "/^main$/"
    },
    {
      "description": [
        "kserve's pin tracks its own release branch only"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "**/docker-bake.hcl"
      ],
      "matchDepNames": [
        "kserve/kserve"
      ],
      "allowedVersions": "/^release-0\\.19$/"
    },
    {
      "description": [
        "Commit pins have no release gate, so a human reads what moved before it ships"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "**/docker-bake.hcl"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": false
    }
  ]
}