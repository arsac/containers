{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = \"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      // Quote-tolerant value capture, matching the preset's annotated manager,
      // so the repo's existing quoted ARG defaults need no reformatting.
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  customDatasources: {
    qbittorrent: {
      defaultRegistryUrlTemplate: "https://github.com/userdocs/qbittorrent-nox-static/releases/latest/download/dependency-version.json",
      format: "json",
      transformTemplates: ['{"releases":[{"version": qbittorrent}]}'],
    },
    "servarr-develop": {
      defaultRegistryUrlTemplate: "https://{{packageName}}.servarr.com/v1/update/develop/changes?os=linux&runtime=netcore",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    "servarr-nightly": {
      defaultRegistryUrlTemplate: "https://{{packageName}}.servarr.com/v1/update/nightly/changes?os=linux&runtime=netcore",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    "sonarr-develop": {
      defaultRegistryUrlTemplate: "https://services.sonarr.tv/v1/update/develop/changes?os=linux&runtime=netcore&version=4.0",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    plex: {
      defaultRegistryUrlTemplate: "https://plex.tv/api/downloads/5.json",
      format: "json",
      transformTemplates: ['{"releases":[{"version": computer.Linux.version}]}'],
    },
  },
  packageRules: [
    {
      description: ["Release Rules for Application Updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      description: ["Auto-merge Application Updates"],
      matchFileNames: ["**/docker-bake.hcl"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: ["Exempt App Updates from prHourlyLimit and create them last, since they still add to the hourly PR count"],
      matchFileNames: ["apps/**"],
      prHourlyLimit: 0,
      prPriority: -1,
    },
    {
      description: ["Allowed Ubuntu Version for Base Images"],
      matchDatasources: ["docker"],
      // kserve-huggingfaceserver ships ubuntu:25.10; a filter that matches no
      // live tag silences every update for that base, digests included.
      matchPackageNames: ["/ubuntu/"],
      allowedVersions: "/25\\.10/",
    },
    {
      description: ["Allowed Alpine Version for Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/alpine/"],
      allowedVersions: "/3\\.22/",
    },
    {
      description: ["Allowed Python Version for Debian Slim Base Images"],
      // crawl4ai and mealie-mcp-server ship python:3.12-slim-bookworm. This
      // filter holds each base on its own series so a patch bump can still
      // reach it; a base on a new series needs its own rule, or the old
      // /3\\.13-alpine3\\.22/ situation again, where nothing matched.
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/python/"],
      allowedVersions: "/3\\.12\\.\\d+-slim-bookworm/",
    },
    {
      description: ["Node: stay on the current even LTS major (block odd/non-LTS 25+)"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/node/"],
      allowedVersions: "<25",
    },
    {
      description: ["Bun builder: stay on 1.2.x (bun.lock / --frozen-lockfile compatibility)"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/oven/"],
      allowedVersions: "<1.3",
    },
    {
      description: ["Auto-merge node/bun base image minor+patch on green CI"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/node/", "/oven/"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: ["llm-inference-bench: python base capped at 3.14 - psutil publishes no cp315 wheels, so a 3.15 base fails the dependency install"],
      matchDatasources: ["docker"],
      matchFileNames: ["apps/llm-inference-bench/Dockerfile"],
      matchPackageNames: ["/python/"],
      allowedVersions: "/3\\.14\\.\\d+-slim-bookworm/",
    },
    {
      description: ["Auto-merge llm-inference-bench python/uv base image minor+patch on green CI"],
      matchDatasources: ["docker"],
      matchFileNames: ["apps/llm-inference-bench/Dockerfile"],
      matchPackageNames: ["/python/", "ghcr.io/astral-sh/uv"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
  ],
}
